{
  "name": "first-line",
  "version": "0.0.0-semantic-release",
  "description": "Get the first line of a file",
  "keywords": [
    "fs"
  ],
  "license": "MIT",
  "author": "Kenan Yildirim <kenan@kenany.me> (https://kenany.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenany/first-line.git"
  },
  "type": "commonjs",
  "types": "dist/index.d.cts",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.cjs": {
      "default": "./dist/*.cjs"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "publint": "publint --strict",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "binary-split": "^1.0.5",
    "once": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@kenan/biome-config": "1.2.0",
    "@types/node": "25.9.9",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
